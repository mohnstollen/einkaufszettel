rules_version = '2';
// Zugriff nur für angemeldete (anonyme) Nutzer und nur mit bekannter Listen-ID.
// Die ID ist lang und zufällig – wer den Einladungslink hat, darf die Liste lesen und bearbeiten.
service cloud.firestore {
  match /databases/{database}/documents {
    match /lists/{listId} {
      allow get, create, update: if request.auth != null && listId.size() >= 20;
      allow list, delete: if false;

      match /{coll}/{docId} {
        allow read, write: if request.auth != null && coll in ['sections', 'products', 'archive'];
      }
    }
  }
}
