rules_version = '2';
// Geteilte Listen: Zugriff nur für angemeldete (anonyme) Nutzer und nur mit bekannter Listen-ID.
// Die ID ist lang und zufällig – wer den Einladungslink hat, darf die Liste lesen und bearbeiten.
service cloud.firestore {
  match /databases/{database}/documents {
    match /lists/{listId} {
      allow get, create, update: if request.auth != null && listId.size() >= 20;
      allow list, delete: if false;

      match /{coll}/{docId} {
        allow read, write: if request.auth != null && coll in ['sections', 'products', 'archive'];
      }
    }

    // Cloud-Sicherung: nur das eigene (Google-)Konto darf lesen und schreiben
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /teile/{teil} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
